<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>文旅广告弹窗</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, "Microsoft YaHei", sans-serif;
    }

    body {
      background: #111;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .phone {
      width: min(100vw, 430px);
      aspect-ratio: 941 / 1672;
      background: #000;
      position: relative;
      overflow: hidden;
    }

    .screen {
      position: absolute;
      inset: 0;
      display: none;
    }

    .screen.active {
      display: block;
    }

    .home-bg {
      width: 100%;
      height: 100%;
      background-image: url("data:image/png;base64,");
      background-size: cover;
      background-position: center;
      position: relative;
    }

    .countdown-box {
      position: absolute;
      left: 36.1%;
      top: 32.45%;
      width: 26.6%;
      height: 2.42%;
      background: linear-gradient(90deg, #220000, #7b0000 52%, #220000);
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffd95a;
      font-family: "Courier New", monospace;
      font-size: clamp(11px, 2.75vw, 16px);
      font-weight: 900;
      letter-spacing: -0.2px;
      text-shadow:
        0 0 6px rgba(255, 220, 60, 0.95),
        0 0 12px rgba(255, 0, 0, 0.85);
      z-index: 10;
      animation: timerShake 0.08s infinite;
      overflow: hidden;
      box-shadow: inset 0 0 6px rgba(0,0,0,0.25);
    }

    .buy-click-btn {
      position: absolute;
      left: 16.2%;
      top: 67.6%;
      width: 67.6%;
      height: 7.1%;
      border: none;
      background: transparent;
      cursor: pointer;
      z-index: 20;
      -webkit-tap-highlight-color: transparent;
    }

    .buy-click-btn:active {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 44px;
    }

    .pay-page {
      width: 100%;
      height: 100%;
      background: #f5f6f8;
      color: #111;
      position: relative;
      padding-top: 44px;
    }

    .status-bar {
      height: 44px;
      color: #111;
      background: #fff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 22px;
      font-size: 14px;
      font-weight: 600;
      position: absolute;
      top: 0;
      width: 100%;
      z-index: 30;
    }

    .status-right {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .signal {
      display: flex;
      align-items: flex-end;
      gap: 2px;
      height: 12px;
    }

    .signal span {
      width: 3px;
      background: currentColor;
      border-radius: 2px;
      display: block;
    }

    .signal span:nth-child(1) { height: 4px; }
    .signal span:nth-child(2) { height: 6px; }
    .signal span:nth-child(3) { height: 8px; }
    .signal span:nth-child(4) { height: 10px; }

    .battery {
      width: 24px;
      height: 12px;
      border: 1.8px solid currentColor;
      border-radius: 3px;
      position: relative;
      padding: 1px;
    }

    .battery::after {
      content: "";
      position: absolute;
      right: -4px;
      top: 3px;
      width: 2px;
      height: 5px;
      background: currentColor;
      border-radius: 1px;
    }

    .battery-level {
      height: 100%;
      width: 70%;
      background: currentColor;
      border-radius: 1px;
    }

    .pay-header {
      height: 52px;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      font-size: 17px;
      font-weight: bold;
      border-bottom: 1px solid #eee;
    }

    .back {
      position: absolute;
      left: 18px;
      font-size: 28px;
      cursor: pointer;
    }

    .order-box {
      margin: 18px;
      background: #fff;
      border-radius: 18px;
      padding: 20px;
      box-shadow: 0 8px 22px rgba(0,0,0,0.05);
    }

    .order-title {
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 16px;
    }

    .order-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #666;
      font-size: 15px;
      margin-top: 12px;
    }

    .order-row strong {
      color: #111;
    }

    .pay-amount {
      font-size: 28px;
      color: #e60012;
      font-weight: 900;
    }

    .section-title {
      margin: 24px 18px 10px;
      color: #666;
      font-size: 14px;
      font-weight: bold;
    }

    .card-list {
      margin: 0 18px;
      background: #fff;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 8px 22px rgba(0,0,0,0.05);
    }

    .bank-card {
      display: flex;
      align-items: center;
      padding: 20px 18px;
      gap: 12px;
      cursor: pointer;
      border: 2px solid transparent;
    }

    .bank-card.selected {
      border-color: #ff4b2b;
      background: #fff7f2;
    }

    .card-info {
      flex: 1;
    }

    .card-name {
      font-size: 16px;
      font-weight: bold;
      color: #111;
      line-height: 1.5;
    }

    .radio {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid #ccc;
      position: relative;
      flex-shrink: 0;
    }

    .bank-card.selected .radio {
      border-color: #ff4b2b;
      background: #ff4b2b;
    }

    .bank-card.selected .radio::after {
      content: "✓";
      color: #fff;
      font-size: 14px;
      font-weight: bold;
      position: absolute;
      left: 4px;
      top: 0;
    }

    .pay-btn-wrap {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      padding: 18px;
      background: #fff;
      border-top: 1px solid #eee;
    }

    .pay-btn {
      width: 100%;
      height: 54px;
      border: none;
      border-radius: 30px;
      background: linear-gradient(90deg, #ff3030, #ff7a00);
      color: #fff;
      font-size: 20px;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(255, 89, 48, 0.35);
    }

    .pay-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      box-shadow: none;
    }

    .loading-mask {
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.78);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 50;
      flex-direction: column;
      color: #333;
      font-weight: bold;
    }

    .loading-mask.show {
      display: flex;
    }

    .loader {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 5px solid #ddd;
      border-top-color: #ff4b2b;
      animation: spin 0.8s linear infinite;
      margin-bottom: 14px;
    }

    .success-mask {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.45);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 60;
    }

    .success-mask.show {
      display: flex;
    }

    .success-box {
      width: 240px;
      height: 200px;
      background: rgba(255, 255, 255, 0.94);
      border-radius: 26px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      box-shadow: 0 16px 45px rgba(0, 0, 0, 0.35);
      animation: pop 0.35s ease;
    }

    .check {
      width: 82px;
      height: 82px;
      border-radius: 50%;
      background: #20c36b;
      color: #fff;
      font-size: 52px;
      line-height: 82px;
      text-align: center;
      margin-bottom: 18px;
      font-weight: bold;
    }

    .success-box h2 {
      color: #18a75a;
      font-size: 28px;
      font-weight: 900;
    }

    .close-success {
      position: absolute;
      bottom: 120px;
      left: 50%;
      transform: translateX(-50%);
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.9);
      background: rgba(0,0,0,0.3);
      color: #fff;
      font-size: 30px;
      line-height: 38px;
      cursor: pointer;
    }

    @keyframes timerShake {
      0% { transform: translateX(0); }
      50% { transform: translateX(1px); }
      100% { transform: translateX(-1px); }
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @keyframes pop {
      0% { transform: scale(0.75); opacity: 0; }
      80% { transform: scale(1.06); }
      100% { transform: scale(1); opacity: 1; }
    }
  </style>
</head>

<body>
  <div class="phone">

    <div class="screen active" id="homeScreen">
      <div class="home-bg">
        <div class="countdown-box" id="countdown">10:00.000000</div>
        <button class="buy-click-btn" onclick="goPayPage()"></button>

        <div class="success-mask" id="successMask">
          <div class="success-box">
            <div class="check">✓</div>
            <h2>办理成功</h2>
          </div>
          <button class="close-success" onclick="hideSuccess()">×</button>
        </div>
      </div>
    </div>

    <div class="screen pay-page" id="payScreen">
      <div class="status-bar">
        <span class="phone-time">--:--</span>
        <div class="status-right">
          <div class="signal">
            <span></span><span></span><span></span><span></span>
          </div>
          <span>5G</span>
          <div class="battery"><div class="battery-level"></div></div>
        </div>
      </div>

      <div class="pay-header">
        <span class="back" onclick="backHome()">‹</span>
        确认付款
      </div>

      <div class="order-box">
        <div class="order-title">旅行民宿 VIP 卡</div>
        <div class="order-row">
          <span>订单金额</span>
          <strong class="pay-amount">¥2999</strong>
        </div>
        <div class="order-row">
          <span>订单类型</span>
          <strong>全年民宿 VIP 卡</strong>
        </div>
      </div>

      <div class="section-title">选择付款方式</div>

      <div class="card-list">
        <div class="bank-card" id="bankCard" onclick="selectCard()">
          <div class="card-info">
            <div class="card-name">信用卡 6226 **** 8752 **** 3917</div>
          </div>
          <div class="radio"></div>
        </div>
      </div>

      <div class="pay-btn-wrap">
        <button class="pay-btn" id="payBtn" disabled onclick="confirmPay()">确认支付 ¥2999</button>
      </div>

      <div class="loading-mask" id="loadingMask">
        <div class="loader"></div>
        <div>支付处理中...</div>
      </div>
    </div>

  </div>

  <script>
    let cardSelected = false;
    const countdownTotal = 10 * 60 * 1000;
    const countdownStart = performance.now();

    function updateCountdown() {
      const elapsed = performance.now() - countdownStart;
      const left = Math.max(0, countdownTotal - elapsed);
      const minutes = Math.floor(left / 60000);
      const seconds = Math.floor((left % 60000) / 1000);
      const micro = Math.floor((left % 1000) * 1000);

      document.getElementById("countdown").textContent =
        String(minutes).padStart(2, "0") + ":" +
        String(seconds).padStart(2, "0") + "." +
        String(micro).padStart(6, "0");

      requestAnimationFrame(updateCountdown);
    }
    updateCountdown();

    function goPayPage() {
      document.getElementById("homeScreen").classList.remove("active");
      document.getElementById("payScreen").classList.add("active");
    }

    function backHome() {
      document.getElementById("payScreen").classList.remove("active");
      document.getElementById("homeScreen").classList.add("active");
    }

    function selectCard() {
      cardSelected = true;
      document.getElementById("bankCard").classList.add("selected");
      document.getElementById("payBtn").disabled = false;
    }

    function confirmPay() {
      if (!cardSelected) return;
      document.getElementById("loadingMask").classList.add("show");
      setTimeout(function() {
        document.getElementById("loadingMask").classList.remove("show");
        document.getElementById("payScreen").classList.remove("active");
        document.getElementById("homeScreen").classList.add("active");
        document.getElementById("successMask").classList.add("show");
      }, 900);
    }

    function hideSuccess() {
      document.getElementById("successMask").classList.remove("show");
    }

    function updatePhoneTime() {
      const now = new Date();
      const time = now.toLocaleTimeString("zh-CN", {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false
      });
      document.querySelectorAll(".phone-time").forEach(function(el) {
        el.textContent = time;
      });
    }
    updatePhoneTime();
    setInterval(updatePhoneTime, 1000);

    if ("getBattery" in navigator) {
      navigator.getBattery().then(function(battery) {
        const percent = Math.round(battery.level * 100);
        document.querySelectorAll(".battery-level").forEach(function(el) {
          el.style.width = percent + "%";
        });
      });
    }
  </script>
</body>
</html>
